# Copy to .env.local and fill in. Never put real values in this file: it is committed.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional. Defaults to Shopify's hosted example profile until we host our own.
UCP_AGENT_PROFILE_URL=

# Optional. Saved catalog ID from Dev Dashboard > Catalogs, to scope searches.
SHOPIFY_CATALOG_ID=
